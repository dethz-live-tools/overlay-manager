{
  "name": "overlay-manager",
  "version": "1.3.0",
  "description": "CLI tool for stream overlay management",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "overlay-manager": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run build:cli && bun run build:lib && bun run build:types",
    "build:cli": "bun build src/cli.ts --outfile dist/cli.mjs --target node && chmod +x dist/cli.mjs",
    "build:lib": "bun build src/index.ts --outfile dist/index.mjs --target node",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bin": "bun build src/cli.ts --compile --outfile build/overlay-manager",
    "build:all": "bun run build && bun run build:bin",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/cli.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "chalk": "^6.0.1",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
